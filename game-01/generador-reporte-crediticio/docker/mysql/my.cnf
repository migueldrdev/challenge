# =============================================================================
# CONFIGURACIÓN MYSQL PARA DESARROLLO
# =============================================================================
# Este archivo contiene configuraciones de MySQL optimizadas para desarrollo
# y para el procesamiento de reportes crediticios masivos.
#
# OPTIMIZACIONES ESPECÍFICAS PARA TU PROYECTO:
# - Buffer pool grande para consultas UNION ALL de múltiples tablas
# - Configuración para manejar consultas con millones de registros
# - Log binario deshabilitado para mejor rendimiento en desarrollo
#
# IMPORTANTE:
# - Esta configuración es para DESARROLLO
# - En producción, ajustar según recursos del servidor
# =============================================================================

[mysqld]
# -------------------------------------------------------------------------
# CONFIGURACIÓN GENERAL
# -------------------------------------------------------------------------
# Charset UTF8MB4 para soporte completo de Unicode (emojis, caracteres especiales)
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Timezone del servidor
default-time-zone = '-06:00'

# -------------------------------------------------------------------------
# MOTOR InnoDB - CONFIGURACIÓN DE RENDIMIENTO
# -------------------------------------------------------------------------
# Buffer pool: Memoria dedicada a cachear datos e índices
# CRÍTICO para consultas de reportes masivos
# En desarrollo: 256MB es suficiente
# En producción: 70-80% de la RAM disponible
innodb_buffer_pool_size = 256M

# Tamaño del log de transacciones
# Mayor tamaño = menos I/O pero más memoria
innodb_log_file_size = 64M

# Flush logs cada segundo (balance entre rendimiento y durabilidad)
# 0 = más rápido pero riesgo de pérdida de datos
# 1 = más seguro (default)
# 2 = balance (recomendado para desarrollo)
innodb_flush_log_at_trx_commit = 2

# Deshabilitar double write buffer en desarrollo (más rápido)
# ADVERTENCIA: Habilitar en producción para integridad de datos
innodb_doublewrite = OFF

# -------------------------------------------------------------------------
# CONFIGURACIÓN DE CONSULTAS
# -------------------------------------------------------------------------
# Tamaño máximo de paquetes (importante para exports grandes)
max_allowed_packet = 64M

# Timeout de conexiones inactivas (segundos)
wait_timeout = 600
interactive_timeout = 600

# Caché de consultas (deprecated en MySQL 8, pero útil para versiones anteriores)
# query_cache_type = 0 (deshabilitado por defecto en MySQL 8)

# Memoria para operaciones de ordenamiento
sort_buffer_size = 4M

# Memoria para joins sin índices
join_buffer_size = 4M

# Límite de conexiones simultáneas
max_connections = 100

# -------------------------------------------------------------------------
# TABLAS TEMPORALES
# -------------------------------------------------------------------------
# Tamaño máximo de tablas temporales en memoria
tmp_table_size = 64M
max_heap_table_size = 64M

# -------------------------------------------------------------------------
# LOGS - DESARROLLO
# -------------------------------------------------------------------------
# Log de consultas lentas (útil para optimización)
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow-query.log
long_query_time = 2

# Log general deshabilitado (habilitar solo para debugging profundo)
general_log = 0

# Log binario deshabilitado en desarrollo (mejora rendimiento)
# ADVERTENCIA: Habilitar en producción si usas replicación
skip-log-bin

# -------------------------------------------------------------------------
# SEGURIDAD
# -------------------------------------------------------------------------
# Desactivar symbolic links por seguridad
symbolic-links = 0

# Permitir solo conexiones locales y desde la red Docker
bind-address = 0.0.0.0

[client]
# Configuración del cliente MySQL
default-character-set = utf8mb4

[mysql]
# Configuración para el CLI de MySQL
default-character-set = utf8mb4
