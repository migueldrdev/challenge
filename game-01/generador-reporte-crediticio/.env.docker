# =============================================================================
# VARIABLES DE ENTORNO PARA DOCKER - DESARROLLO
# =============================================================================
# Este archivo contiene las variables de entorno necesarias para ejecutar
# la aplicación Laravel en contenedores Docker.
#
# USO:
# 1. Copiar este archivo a .env: cp .env.docker .env
# 2. Ajustar valores según tu entorno
# 3. Ejecutar: docker compose up -d
#
# IMPORTANTE:
# - En producción, NUNCA commitear el archivo .env real
# - Cambiar todas las contraseñas por valores seguros
# - APP_KEY debe generarse con: php artisan key:generate
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE LA APLICACIÓN
# -----------------------------------------------------------------------------
APP_NAME="Generador Reportes Crediticios"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS - MYSQL EN DOCKER
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=creditreport
DB_USERNAME=laravel
DB_PASSWORD=secret

# Contraseña root (solo para administración, no usar en la app)
DB_ROOT_PASSWORD=rootpassword

# Puerto externo para conectar desde tu máquina (DBeaver, TablePlus, etc.)
DB_EXTERNAL_PORT=3306

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE REDIS - CACHÉ Y COLAS
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Puerto externo para debugging con redis-cli
REDIS_EXTERNAL_PORT=6379

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE COLAS - USAR REDIS (Recomendado)
# -----------------------------------------------------------------------------
# Redis es más eficiente que database para jobs de reportes masivos
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE CACHÉ Y SESIONES
# -----------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE ALMACENAMIENTO
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=public

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE CORREO - MAILPIT (Desarrollo)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="reportes@creditreport.local"
MAIL_FROM_NAME="${APP_NAME}"

# Puertos de Mailpit
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE LOGS
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE PUERTOS DOCKER
# -----------------------------------------------------------------------------
# Puerto de la aplicación web
APP_PORT=8080

# Puerto de Vite HMR (Hot Module Replacement)
VITE_PORT=5173

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE USUARIO (Para permisos de archivos)
# -----------------------------------------------------------------------------
# Obtén tu USER_ID con: id -u
# Obtén tu GROUP_ID con: id -g
USER_ID=1000
GROUP_ID=1000

# -----------------------------------------------------------------------------
# VITE - CONFIGURACIÓN PARA DOCKER
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
